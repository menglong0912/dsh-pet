{
  "name": "dsh-pet",
  "version": "0.3.8",
  "description": "吃白饭的蓝色大肥鱼，赖在 macOS 桌面上不走了。平时爱玩魔方、爱吃各种零食、偶尔打个盹，闲不住就在桌面上溜达两圈，被你拖来甩去也照旧赖着；你忙起来它跟着忙前忙后，闲下来爱碎碎念，还乐意陪你唠两句。",
  "icon": "assets/logo.png",
  "keywords": [
    "desktop-pet",
    "pet",
    "floating-widget"
  ],
  "homepage": "https://github.com/yangfan000818-droid/dsh-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangfan000818-droid/dsh-pet.git"
  },
  "bugs": {
    "url": "https://github.com/yangfan000818-droid/dsh-pet/issues"
  },
  "_comment": [
    "=============== dsh-pet 包清单说明 ===============",
    "type: module —— 本包是 ESM",
    "main: lib/app.js —— 独立桌面应用入口（Electron 主进程），由 npm run bundle 生成",
    "icon —— 应用图标：相对 package.json 的图片路径，打包时使用 assets/logo.png",
    "scripts.bundle —— tsdown 构建 src → lib（app 与 standalone 两个入口）",
    "scripts.build:desktop-core —— 构建桌面共享核心 runtime/electron-helper/shared-core.js（window.PetShared）",
    "scripts.dist —— electron-builder 打解包目录（macOS 出 .app，Windows 出 win-unpacked）",
    "engines —— Node.js 兼容下限",
    "================================================"
  ],
  "type": "module",
  "main": "lib/app.js",
  "scripts": {
    "bundle": "tsdown",
    "build:desktop-core": "node scripts/build-desktop-core.mjs",
    "watch": "tsdown --watch",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "start:desktop": "node scripts/start-desktop.mjs",
    "standalone": "node lib/standalone.js",
    "start:app": "node scripts/start-app.mjs",
    "dist": "node scripts/dist.mjs",
    "dev:mock": "node scripts/dev/mock-server.mjs",
    "test": "node --experimental-strip-types --import ./scripts/test-register.mjs --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "node --test scripts/tests/*.test.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0",
    "openai": "7.39.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "rolldown": "1.0.0-beta.7",
    "tsdown": "^0.8.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0"
  }
}
